{
  "name": "memoframe-desktop",
  "version": "1.0.0",
  "description": "MemoFrame — Local Photo & Face Intelligence (Electron + React + TypeScript + Vite + Tailwind CSS)",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "build:backend": "python -m PyInstaller --noconfirm --onedir --name server --paths ../backend --paths .. --distpath build-backend --workpath build-backend-work ../bridge/server.py",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"electron/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"electron/**/*.js\"",
    "start": "npm run build:web && electron .",
    "package": "npm run build:web && electron-builder",
    "test:py": "pytest",
    "test": "npm run typecheck && npm run test:py"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "tar": "^7.5.23",
    "@electron/universal": "^3.0.6",
    "minimatch": "^11.0.9"
  },
  "build": {
    "appId": "com.memoframe.desktop",
    "productName": "MemoFrame",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/logo.ico",
      "public/logo.png",
      "package.json"
    ],
    "win": {
      "icon": "public/logo.ico",
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../bridge",
        "to": "bridge",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!tests/**"
        ]
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!tests/**"
        ]
      },
      {
        "from": "build-backend/server",
        "to": "bridge-bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../workspace/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
