{
  "name": "memoframe-desktop",
  "version": "2.0.0",
  "description": "MemoFrame \u2014 Local Photo & Face Intelligence (Electron + React + TypeScript + Vite + Tailwind CSS)",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "start": "npm run build:web && electron .",
    "package": "npm run build:web && electron-builder",
    "test:py": "pytest",
    "test": "npm run typecheck && npm run test:py"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.memoframe.desktop",
    "productName": "MemoFrame",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../bridge",
        "to": "bridge",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!tests/**"
        ]
      }
    ]
  }
}
